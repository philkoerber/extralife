{
  "name": "@philkoerber/extralife",
  "version": "0.1.0",
  "description": "Multi-system emulator library for the web: Rust/WASM cores wrapped in typed React primitives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philkoerber/extralife.git",
    "directory": "packages/extralife"
  },
  "homepage": "https://github.com/philkoerber/extralife#readme",
  "bugs": "https://github.com/philkoerber/extralife/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "wasm"],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "build:wasm": "node ../../scripts/build-package.mjs --wasm-only",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
